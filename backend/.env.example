# ==============================================================================
# AquaSense-IoT Backend Configuration (.env.example)
# Copy this file to .env and configure with your local or staging values.
# DO NOT COMMIT SENSITIVE VALUES OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
PROJECT_NAME="AquaSense-IoT Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Tokens
SECRET_KEY="replace_with_a_secure_random_32_character_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="aquasense_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"

# Database Connection URLs
# AsyncPG URL for FastAPI runtime
DATABASE_URL="postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/aquasense_db"
# Synchronous URL for Alembic database migrations
SYNC_DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/aquasense_db"

# Machine Learning Engine Artifact Paths
MODEL_ARTIFACT_PATH="ml_engine/models/root_zone_model.joblib"
MODEL_METADATA_PATH="ml_engine/models/model_metadata.json"

# External Data Sources - NASA Earthdata (SMAP)
# Register at https://urs.earthdata.nasa.gov/ for free credentials
EARTHDATA_USERNAME="your_earthdata_username"
EARTHDATA_PASSWORD="your_earthdata_password"
NASA_CMR_API_URL="https://cmr.earthdata.nasa.gov/search"

# External Data Sources - Open-Meteo
OPEN_METEO_HISTORICAL_URL="https://archive-api.open-meteo.com/v1/archive"
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
