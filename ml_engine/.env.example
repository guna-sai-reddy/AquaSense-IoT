# ==============================================================================
# AquaSense-IoT ML Engine Configuration (.env.example)
# Copy to .env for local model training and data ingestion scripts.
# ==============================================================================

# NASA Earthdata Credentials (for SMAP download)
EARTHDATA_USERNAME="your_earthdata_username"
EARTHDATA_PASSWORD="your_earthdata_password"

# ISMN (International Soil Moisture Network) Credentials
# Register at https://ismn.earth/ for access to in-situ ground station datasets
ISMN_USERNAME="your_ismn_username"
ISMN_PASSWORD="your_ismn_password"

# Data directories
RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
MODELS_DIR="./models"
